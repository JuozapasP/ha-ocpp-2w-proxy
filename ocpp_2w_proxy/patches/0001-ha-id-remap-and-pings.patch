+def parse_ping(value: str, default: float | None) -> float | None:
+    """Return a ping interval, or None when keepalive is disabled."""
+    text = str(value).strip().lower()
+    if text in ("", "none", "null", "off", "disable", "disabled"):
+        return None
+    try:
+        number = float(text)
+    except ValueError:
+        logger.warning("Invalid ping value %r, using %s", value, default)
+        return default
+    if number <= 0:
+        return None
+    return number
+
+
+def optional_ping(section: str, option: str, default: float | None) -> float | None:
+    if not config.has_option(section, option):
+        return default
+    return parse_ping(config.get(section, option), default)
+
+
+def positive_float(section: str, option: str, default: float) -> float:
+    if not config.has_option(section, option):
+        return default
+    value = float(config.get(section, option))
+    if value < 0:
+        raise ValueError(f"{section}.{option} must be >= 0")
+    return value
+
+
+def validate_cp_id(cp_id: str) -> str:
+    """Accept the ids used on the wire, including hyphens."""
+    cp_id = unquote(str(cp_id)).strip()
+    if not cp_id or cp_id in (".", ".."):
+        raise ValueError("charge point id is empty")
+    if any(ord(ch) < 32 or ch in "/\\?# \t" for ch in cp_id):
+        raise ValueError(f"invalid charge point id {cp_id!r}")
+    return cp_id
+
+
+def extract_charger_id(path: str) -> str:
+    """Last path segment of the charger URL. The value is not the upstream id."""
+    path = path.split("?", 1)[0].split("#", 1)[0]
+    parts = [part for part in path.split("/") if part]
+    if not parts:
+        raise ValueError("connection URL has no charge point id")
+    return validate_cp_id(parts[-1])
+
+
+def configured_cp_id(option: str, fallback: str) -> str:
+    if config.has_option("ext-server", option):
+        value = config.get("ext-server", option).strip()
+        if value:
+            return validate_cp_id(value)
+    return validate_cp_id(fallback)
+
+
+def join_cp_url(base: str, cp_id: str) -> str:
+    """Append one charge point id to a CSMS base URL."""
+    base = base.strip()
+    parts = urlsplit(base)
+    if parts.scheme not in ("ws", "wss") or not parts.netloc:
+        raise ValueError(f"CSMS URL must be ws:// or wss://, got {base!r}")
+    if parts.username or parts.password:
+        raise ValueError("put the CSMS password in server_auth_password, not in the URL")
+    cp_id = validate_cp_id(cp_id)
+    path = "/" + quote(cp_id, safe="-_.~:")
+    return urlunsplit((parts.scheme, parts.netloc, path, "", ""))
+
+
+def safe_url(url: str) -> str:
+    parts = urlsplit(url)
+    if not (parts.username or parts.password):
+        return url
+    host = parts.hostname or ""
+    if parts.port:
+        host = f"{host}:{parts.port}"
+    return urlunsplit((parts.scheme, host, parts.path, "", ""))
+
+
+def basic_authorization(username: str, password: str) -> str:
+    token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
+    return f"Basic {token}"
+
+
+def header_value(headers, name: str) -> str | None:
+    if headers is None:
+        return None
+    value = headers.get(name)
+    if value is None:
+        return None
+    value = str(value)
+    if not value or any(ch in value for ch in "\r\n\0"):
+        return None
+    return value
+
+
+def decode_ocpp_message(message) -> Tuple[OCPPMessageType, str]:
+    if isinstance(message, bytes):
+        message = message.decode("utf-8")
+    payload = json.loads(message)
+    if not isinstance(payload, list) or len(payload) < 2:
+        raise ValueError("not an OCPP message")
+    return OCPPMessageType(payload[0]), str(payload[1])
